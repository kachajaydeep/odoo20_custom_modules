<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherited_direct_login" model="ir.ui.view">
        <field name="name">res.config.settings.view.inherited.direct.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="direct_login_for_employee" title="Employees can direct ligin to assigned pos store without navigating to any other menus." string="Direct Login for Employee" help="Allow to log employee to directly assigned pos store withouit navigating to any other menus.">
                    <field name="nf_enable_direct_login" readonly="pos_has_active_session"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
