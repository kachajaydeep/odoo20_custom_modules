<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_upi" model="payment.provider">
        <field name="name">MyFatoorah</field>
        <field name="code">myfatoorah</field>
        <field name="image_128" type="base64" file="nf_myfatoorah_payment/static/description/icon.png"/>
        <field name="payment_method_ids" eval="[Command.set([ref('nf_myfatoorah_payment.payment_method_myfatoorah')])]"/>
        <field name="available_currency_ids" eval="[Command.set([ref('base.KWD'), ref('base.BHD'), ref('base.JOD'),
                                                    ref('base.OMR'), ref('base.AED'), ref('base.SAR'), ref('base.QAR'),
                                                    ref('base.EGP'),])]"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
    </record>
</odoo>
