<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="pos_day_wise_report_wizard_view_form" model="ir.ui.view">
        <field name="name">pos.day.wise.report.wizard.view.form</field>
        <field name="model">pos.day.wise.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Day Wise Report">
                <group>
                    <group>
                        <field name="pos_hr_installed" invisible="1" />
                        <field name="date" />
                        <field name="user_ids" widget="many2many_tags" invisible="pos_hr_installed" />
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags" invisible="not pos_hr_installed" />
                    </group>
                </group>
                <footer>
                    <button name="print_report" string="Print" class="oe_highlight" type="object" icon="fa-print" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="pos_day_wise_report_wizard_action" model="ir.actions.act_window">
        <field name="name">POS Day Wise Report</field>
        <field name="res_model">pos.day.wise.report.wizard</field>
        <field name="view_id" ref="pos_day_wise_report_wizard_view_form" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="pos_day_wise_report_menu" name="Pos Day Wise Report" action="pos_day_wise_report_wizard_action" parent="point_of_sale.menu_point_rep" />
</odoo>