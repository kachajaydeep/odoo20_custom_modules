<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_multi_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.inherit.multi.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="inside">
                <setting id="nf_pos_multi_barcdoe" string="Multi Barcode" help="Allow to add Multi barcode for product. Also enable 'Multi Barcode' feature in General Settings to add multiple barcodes for Products.">
                    <field name="nf_enable_pos_multi_barcode"/>
                </setting>
            </block>
        </field>
        
    </record>
</odoo>
