<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nf_pos_cash_control_receipt.CashReceipt">
        <div class="pos-receipt">

            <div class="pos-receipt-contact">
                <table class="nf_in_out_statement_table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 25%; text-align: left;">Date</th>
                            <th style="width: 35%; text-align: left;">Reason</th>
                            <th style="width: 20%; text-align: right;">Credit</th>
                            <th style="width: 20%; text-align: right;">Debit</th>
                        </tr>
                    </thead>
                    <tbody>

                        <!-- Single cash in/out receipt -->
                        <t t-if="this.props.sigle_receipt">
                            <tr>
                                <td style="text-align: left; font-size: 10px;">
                                    <t t-out="this.props.date"/>
                                </td>
                                <td style="text-align: left;">
                                    <t t-out="this.props.reason"/>
                                </td>
                                <t t-if="this.props.type == 'in'">
                                    <td style="text-align: right;">
                                        <t t-out="this.env.utils.formatCurrency(this.props.amount)"/>
                                    </td>
                                    <td style="text-align: right;">-</td>
                                </t>
                                <t t-else="">
                                    <td style="text-align: right;">-</td>
                                    <td style="text-align: right;">
                                        <t t-out="this.env.utils.formatCurrency(this.props.amount)"/>
                                    </td>
                                </t>
                            </tr>
                        </t>

                        <!-- All cash in/out receipt -->
                        <t t-else="">
                            <t t-set="total_cash_in" t-value="0"/>
                            <t t-set="total_cash_out" t-value="0"/>

                            <tr t-foreach="this.props.TotalCashData" t-as="data" t-key="data.id">
                                <t t-set="cash" t-value="data.payment_ref.split('-')"/>
                                <td style="text-align: left; font-size: 10px;">
                                    <t t-out="data.date"/>
                                </td>
                                <td style="text-align: left;">
                                    <t t-out="cash[2]"/>
                                </td>
                                <t t-if="cash[1] == 'in'">
                                    <td style="text-align: right;">
                                        <t t-out="this.env.utils.formatCurrency(data.amount)"/>
                                        <t t-set="total_cash_in" t-value="data.amount + total_cash_in"/>
                                    </td>
                                    <td style="text-align: right;">-</td>
                                </t>
                                <t t-else="">
                                    <td style="text-align: right;">-</td>
                                    <td style="text-align: right;">
                                        <t t-out="this.env.utils.formatCurrency(data.amount)"/>
                                        <t t-set="total_cash_out" t-value="data.amount + total_cash_out"/>
                                    </td>
                                </t>
                            </tr>

                            <tr style="font-weight: bold; border-top: 1px solid #000;">
                                <td colspan="2" style="text-align: right; font-size: 15px;">Total</td>
                                <td style="text-align: right;">
                                    <t t-out="this.env.utils.formatCurrency(total_cash_in)"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-out="this.env.utils.formatCurrency(total_cash_out)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>