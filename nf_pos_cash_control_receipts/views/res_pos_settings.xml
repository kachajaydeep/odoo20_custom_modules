<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='nf_pos_cash_control_receipt_config_settings' model='ir.ui.view'>
        <field name='name'>nf.pos.cash.in.out.receipt.view.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name='arch' type='xml'>
            <setting id="iface_tipproduct" position="after">
                <setting>
                    <field name="nf_enable_cash_in_ont_receipt" readonly="pos_has_active_session"/>
                </setting>
                <setting>
                    <field name="nf_enable_cash_report" readonly="pos_has_active_session"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>