<?xml version="1.0" encoding="UTF-8"?>
<template id="nf_pos_dashboard_design">
    <t t-name="NfDashboard">
        <t t-name="kanban-box">
            <section id="dashboard_counter" style="background-color: #f2f7ff; min-width: 85% !important; width: 100% !important;">
                <div class="NfTemp">
                    <span class="nf-times-title" > Product Sales </span>
                    <i class="nf-times fa fa-times-circle-o" />
                    <div class="nf-product-data">
                        <table class="product-data-table" style="width: 98%; margin-left: 20px;">
                            <thead>
                                <th style='padding: 10px;'>#</th>
                                <th style='padding: 10px;'> Product Name </th>
                                <th style='padding: 10px;'> Quantity </th>
                                <th style='padding: 10px;'> Amount </th>
                            </thead>
                            <tbody> </tbody>
                        </table>    
                    </div>
                </div>
                <div class="container" style="width: 100% !important; max-width: 85% !important;">
                    <section id="nf_header_section">
                        <div class="row">
                            <div class="col-12 col-lg-9">
                                <div class="row">
                                    <div class="col-6 col-lg-3 col-md-6">
                                        <div class="nf-card">
                                            <div class="card-body nf-card-body px-3 py-4-5">
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="stats-icon red">
                                                            <i class="fa fa-eye"></i>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <h6 class="text-muted font-semibold">Active POS Session</h6>
                                                        <h6 class="font-extrabold mb-0">
                                                            <span id="nf-pos-active-sessions" />
                                                        </h6>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-3 col-md-6">
                                        <div class="nf-card">
                                            <div class="card-body nf-card-body px-3 py-4-5">
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="stats-icon purple">
                                                            <i class="fa fa-shopping-bag"></i>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <h6 class="text-muted font-semibold">Today Order</h6>
                                                        <h6 class="font-extrabold mb-0">
                                                            <span id="nf-today-orders" />
                                                        </h6>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-3 col-md-6">
                                        <div class="card-body nf-card-body px-3 py-4-5">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="stats-icon yellow">
                                                        <i class="fa fa-line-chart"></i>
                                                    </div>
                                                </div>
                                                <div class="col-md-8">
                                                    <h6 class="text-muted font-semibold">Today Sales</h6>
                                                    <h6 class="font-extrabold mb-0">
                                                        <span id="nf-today-total-sales" />
                                                    </h6>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-3 col-md-6">
                                        <div class="card-body Click_product_sold nf-card-body px-3 py-4-5">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="stats-icon green">
                                                        <i class="fa fa-cart-arrow-down"></i>
                                                    </div>
                                                </div>
                                                <div class="col-md-8">
                                                    <h6 class="text-muted font-semibold ">Today Product Sold</h6>
                                                    <h6 class="font-extrabold mb-0">
                                                        <span id="nf-today-product-sales" />
                                                    </h6>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class='col-12 col-lg-3'>
                                <div class="card-body nf-card-body py-4 px-5">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-xl">
                                            <img class="rounded-circle o_user_avatar" style="width: 50px; height: 50px" t-att-src="this.get_user_avtar()" alt="User" />
                                        </div>
                                        <div class="ms-3 nf-user-name" t-if="user">
                                            <h5 class="font-bold">
                                                <t t-log="this" ></t>
                                                <span t-out='user.display_name' />
                                            </h5>
                                            <h6 class="text-muted mb-0">
                                                <span t-out="user.email" />
                                            </h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section>
                        <div class="row">
                            <div class="col-12 col-lg-9">
                                <div class="card-header nf-card-body">
                                    <h4>Today Sales</h4>
                                    <div style="float: right; margin-top: -25px; width: 12%;">
                                        <select class="form-control" id='NfSaleFilter'>
                                            <option value="Day">Today</option>
                                            <option value="Month">This Month</option>
                                            <option value="Year">This Year</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="card-body nf-card-body">
                                    <div class="nf-pos-month-sale-chart"></div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-3">
                                <div class="card-body nf-card-body">
                                    <div class="card-header">
                                        <h4>Today Top Sale</h4>
                                    </div>
                                    <div class="card-body nf-card-body pb-4">
                                        <div class="recent-message d-flex pt-4">
                                            <div class="stats-icon yellow">
                                                <i class="fa fa-clock-o" />
                                            </div>
                                            <div class="name ms-4 ml-4">
                                                <h5 class="mb-1">Today Top Sale</h5>
                                                <h4 class="text-muted mb-0"> <span class="nf_top_sale_of_the_day"> </span> </h4>
                                            </div>
                                        </div>
                                        <div class="recent-message d-flex pt-4">
                                            <div class="stats-icon purple">
                                                <i class="fa fa-line-chart" />
                                            </div>
                                            <div class="name ms-4 ml-4">
                                                <h5 class="mb-1">Month Highest Sale</h5>
                                                <h4 class="text-muted mb-0"> <span class="nf_highest_of_month"></span> </h4>
                                                <h6 class="text-muted mb-0">Lanst 30 Days</h6>
                                            </div>
                                        </div>
                                        <div class="recent-message d-flex pt-4">
                                            <div class="stats-icon red">
                                                <i class="currency_icon" />
                                            </div>
                                            <div class="name ms-4 ml-4">
                                                <h5 class="mb-1">Average Selling Price</h5>
                                                <h4 class="text-muted mb-0"> <span class="nf_avarage_sale_of_month"></span> </h4>
                                                <h6 class="text-muted mb-0">Lanst 30 Days</h6>
                                            </div>
                                        </div>
                                        <div class="recent-message d-flex pt-4 ">
                                            <div class="stats-icon green">
                                                <i class="fa fa-shopping-bag" />
                                            </div>
                                            <div class="name ms-4 ml-4">
                                                <h5 class="mb-1">Month Total Sale</h5>
                                                <h4 class="text-muted mb-0"> <span class="month_sale"></span> </h4>
                                                <h6 class="text-muted mb-0">Lanst 30 Days</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section id="nf-profile-section" style="margin-top: 15px">
                        <div class="row">
                            <div class="col-12 col-xl-3">
                                <div class="card nf-card">
                                    <div class="card-header nf-card-body">
                                        <h4> Top Customer </h4>
                                    </div>
                                    <div class="card-body nf-card-body">
                                        <table  class="table" > 
                                            <thead>
                                                <tr>
                                                    <th>Customer Name</th>
                                                    <th>Products </th>
                                                    <th>Amount </th>
                                                </tr>
                                            </thead>
                                            <tbody class="NF-Customer-Data"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="card nf-card">
                                    <div class="card-header nf-card-body ">
                                        <h4> Top Products </h4>
                                    </div>
                                    <div class="card-body nf-card-body">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-lg">
                                                <thead>
                                                    <tr>
                                                        <th>Product Name</th>
                                                        <th> Sale Qty </th>
                                                        <th> Total </th>
                                                    </tr>
                                                </thead>
                                                <tbody class="nf-stock-update"></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-3">
                                <div class="card nf-card" >
                                    <div class="card-header nf-card-body">
                                        <h4> Payments </h4>
                                    </div>
                                    <div class="card-body nf-card-body">
                                        <div id="chart-profile-visit"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </section>
        </t>
    </t>
</template>