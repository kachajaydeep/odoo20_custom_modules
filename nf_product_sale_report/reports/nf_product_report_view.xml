<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="product_sale_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="page-break-inside: avoid;">
                    <div class="mt-3">
                        <h1>Product Sale Report</h1>
                    </div>
                    <div class="row mb-4">
                        <div class="col-6">
                            <h2>Start Date</h2>
                            <span t-out="start_date"/>
                        </div>
                        <div class="col-6">
                            <h2>End Date</h2>
                            <span t-out="end_date"/>
                        </div>                        
                    </div>
                    <div class="row mb-4">                        
                        <div class="col-6">
                            <h2>Categories</h2>
                            <span t-out="categories"/>
                        </div>
                        <div class="col-6">
                            <h2>Type</h2>
                            <span t-out="report_type"/>
                        </div>
                    </div>
                    <table class="table table-borderless border-0">
                        <thead style="display: table-row-group">
                            <tr>
                                <th class="text-center fw-bold">Product</th>
                                <th class="text-center fw-bold">Quantity</th>
                                <th class="text-center fw-bold">Quantity On Hand</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="product_line_list">
                                <t t-foreach="product_line_list" t-as="line">
                                    <tr>
                                        <td class="text-center">
                                            <span t-out="line['product_name']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-out="line['qty']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-out="line['on_hand_qty']"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td class="text-center text-danger" colspan="3">No records found</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <t t-if="product_line_list">
                        <div class="row mt-3">
                            <div class="col-12 text-end">
                                <table class="table table-sm table-borderless" style="width: auto; margin-left: auto;">
                                    <tr>
                                        <td class="fw-bold pe-3">Total Products:</td>
                                        <td class="text-end" t-out="total_product_count"/>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold pe-3">Total Quantity:</td>
                                        <td class="text-end" t-out="total_qty"/>
                                    </tr>                                    
                                </table>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_product" model="ir.actions.report">
        <field name="name">Product Sale Report</field>
        <field name="model">product.sale.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nf_product_sale_report.product_sale_report</field>
        <!-- <field name="report_file">nf_product_sale_report.product_sale_report</field> -->
        <field name="print_report_name">'Product Report'</field>
        <field name="binding_model_id" ref="model_product_sale_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo>