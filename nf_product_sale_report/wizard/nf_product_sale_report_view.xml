<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nf_product_sale_report_form_view" model="ir.ui.view">
        <field name="name">product.sale.report.form.view</field>
        <field name="model">product.sale.report</field>
        <field name="arch" type="xml">           
            <form string="sale_report_wizard">
                <sheet>
                    <group>
                        <group name="group_date_and_report_type">
                            <field name="nf_start_date" widget="date"/>
                            <field name="nf_product_category_ids" widget="many2many_tags"/>
                        </group>
                        <group name="group_date_and_category">
                            <field name="nf_end_date" widget="date"/>
                            <field name="nf_report_type" widget="radio"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_btn_create_product_sale_report" string="Create Report" type="object" class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>                
        </field>
    </record>

    <record id="action_product_sale_report" model="ir.actions.act_window">
        <field name="name">Product Sale Report</field>
        <field name="res_model">product.sale.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
