<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_payment_list_view" model="ir.ui.view">
        <field name="name">Invoice Hide Amount Payment List View</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_signed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_company_currency_signed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>

    <record id="nf_payment_form_view" model="ir.ui.view">
        <field name="name">Invoice Hide Amount Payment Form View</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>           
        </field>
    </record>

    <record id="nf_payment_kanban_view" model="ir.ui.view">
        <field name="name">Invoice Hide Amount Payment Kanban View</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>           
        </field>
    </record>

    <record id="nf_bill_payment_list_view" model="ir.ui.view">
        <field name="name">Bill Hide Amount Payment List View</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_signed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_company_currency_signed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>         
        </field>
    </record>

    <record id="nf_view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account payment register form view</field> 
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>           
        </field>
    </record>
</odoo>