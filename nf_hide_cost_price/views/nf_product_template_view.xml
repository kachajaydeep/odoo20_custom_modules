<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_product_template_hide_price_form_view" model="ir.ui.view">
        <field name="name">Hide Product Template Price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_cost_price_group</attribute>
            </xpath>
        </field>
    </record>

