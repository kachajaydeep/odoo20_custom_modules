<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_sale_hide_price_form_view" model="ir.ui.view">
        <field name="name">Hide Sale Price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='order_lines']/field[@name='order_line']/form/group/group/field[@name='price_unit']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>

            <!-- <xpath expr="//list/field[@name='price_unit']" position="attributes">
            </xpath> -->
            <xpath expr="//page[@name='order_lines']//list[@name='sol_list']//field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']//list[@name='sol_list']//field[@name='price_total']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']//list[@name='sol_list']//field[@name='price_total'][@optional='hide']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//notebook//group[@name='note_group']//group[@name='sale_total']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field> 
    </record>

