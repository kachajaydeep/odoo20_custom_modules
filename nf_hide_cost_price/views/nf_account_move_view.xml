<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_account_move_price_form_view" model="ir.ui.view">
        <field name="name">Hide Account Move Price</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='price_unit']" position="attributes" >
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//list/field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_payments_widget']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_outstanding_credits_debits_widget']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>

    <record id="nf_account_move_price_list_view" model="ir.ui.view">
        <field name="name">Hide Account Move Price List</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_tax_signed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//list/field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="groups" separator=",">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>            

            <xpath expr="//list/field[@name='amount_residual_signed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>


    <record id="nf_view_account_move_pivot_invoice" model="ir.ui.view">
        <field name="name">Hide Account Move Pivot Price</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_pivot_invoice"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_untaxed']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>


    <record id="nf_view_account_move_graph_invoice" model="ir.ui.view">
