<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="nf_stock_location_list_view" model="ir.ui.view">
        <field name="name">Hide Stock Location List View</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock_account.view_stock_quant_tree_editable_inherit"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='value']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            
        </field>
    </record>

</odoo>
