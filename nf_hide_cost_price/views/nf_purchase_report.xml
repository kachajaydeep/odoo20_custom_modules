<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nf_view_purchase_order_graph" model="ir.ui.view">
        <field name="name">Hide Product Product Price</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_graph"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='untaxed_total']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>

    <record id="nf_view_purchase_order_pivot" model="ir.ui.view">
        <field name="name">Hide Product Product Price</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='untaxed_total']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='price_total']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>

    <record id="nf_purchase_report_view_tree" model="ir.ui.view">
        <field name="name">Hide Product Product Price</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.purchase_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='untaxed_total']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='price_total']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>
</odoo>
