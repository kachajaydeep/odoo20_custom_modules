<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_purchase_hide_price_form_view" model="ir.ui.view">
        <field name="name">Hide Purchase Price</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='price_unit']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//list/field[@name='price_subtotal']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="groups">!nf_hide_cost_price.nf_hide_sale_price_group</attribute>
            </xpath>
        </field>
    </record>

