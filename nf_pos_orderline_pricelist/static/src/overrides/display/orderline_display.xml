<?xml version="1.0" encoding="UTF-8"?>
<template id="template_orderline" xml:space="preserve">
    <t t-name="nf_pos_orderline_pricelist.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('line-details')]" position="after">
            <t t-if="!this.line.combo_parent_id and this.line.price_type != 'manual'">
                <div class="d-flex justify-content-between w-100 fs-3">
                    <p class="text-muted ps-3 mt-2">
                        <span t-if="this.line.getPricelist() and this.line.getPricelist().id != this.pos.config.pricelist_id?.id" 
                            t-out="'- '+this.line.getPricelist().name" class="badge"/>
                        <span t-else=""/>
                    </p>
                    <button class="btn btn-sm btn-light border px-2 py-1" t-on-click="() => this.clickPricelist()">
                        Pricelist
                    </button>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('line-details')]//div[hasclass('product-price')]" position="replace">
            <t t-if="this.line.getPricelist() and this.line.getPricelist().id != this.pos.config.pricelist_id?.id">

                <!-- ── COMBO PARENT with discount ─────────────────────── -->
                <t t-if="this.line.product_id.type === 'combo'">
                    <div t-out="this.env.utils.formatCurrency(this.line._originalComboPrice * this.line.qty)" class="product-price price text-muted small text-decoration-line-through"/>
                    <div t-out="this.env.utils.formatCurrency(this.line._discountedComboPrice * this.line.qty)" class="product-price price fw-bolder" style="margin-left: 15px"/>
                </t>

                <!-- ── REGULAR PRODUCT with pricelist and automatic price ─────────────────── -->
                <t t-elif="this.line.product_id.type !== 'combo' and this.line.price_type != 'manual'">
                    <div t-if="this.line.getbasePrice()" t-out="this.env.utils.formatCurrency(this.line.getbasePrice())" class="product-price price text-muted small text-decoration-line-through" t-attf-class="font-monospace text-muted small text-decoration-line-through" />
                    <div t-out="this.env.utils.formatCurrency(this.line.displayPrice)" class="product-price price" style="margin-left: 15px;font-weight: 700;" t-attf-class="font-monospace fw-bold" />
                </t>

                <!-- ── NO DISCOUNT ────────────────────────────────────── -->
                <t t-else="">
                    <div t-if="this.line" t-out="this.env.utils.formatCurrency(this.line.displayPriceNoDiscount)" class="product-price price fw-semibold" t-attf-class="font-monospace" />
                </t>
            </t>
            <!-- ── NO PRICELIST ───────────────────────────────────────── -->
            <t t-else="">
                <div t-if="this.line" t-out="this.env.utils.formatCurrency(this.line.displayPriceNoDiscount)" class="product-price price fw-semibold" t-attf-class="font-monospace" />
            </t>
        </xpath>
    </t>
</template>