<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="nf_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">                
                <div id="contacts_settings" position="after">
                    <div class="app_settings_block" data-string="Product" string="Product" data-key="product_multi_barcode">

                        <h2>Product Multi Barcode Configuration</h2>

                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">

                                <div class="o_setting_left_pane">
                                    <field name="nf_multi_barcode_unique"/>
                                </div>

                                <div class="o_setting_right_pane">
                                    <label for="nf_multi_barcode_unique"/>
                                    <div class="text-muted">
                                        Enable this option to enforce unique barcodes for products.
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </field>
        </record>
</odoo>