<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="nf_multi_barcode_unique" invisible="1"/>
            </field>    
            <xpath expr="//notebook" position="inside">
                <page string="Barcodes" name="barcodes" invisible="not nf_multi_barcode_unique" >
                    <field name="barcode_ids" editable="bottom">
                        <list editable="bottom">
                            <field name="name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="nf_product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="after">
                <field name="barcode_ids" string="Multi Barcodes"/>
            </xpath>
        </field>
    </record>
</odoo>