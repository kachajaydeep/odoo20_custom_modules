<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='nf_2x_receipt_print_config' model='ir.ui.view'>
        <field name='name'>nf.pos.order.2x.config.view.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name='arch' type='xml'>
            <block id="pos_bills_and_receipts_section" position="inside">
                <setting string="Enable 2X Receipt Printing" help="Enable 'Automatic Receipt Printing' in the Bills &amp; Receipts tab before using this feature." id="iface_printbill">
                    <field name="nf_enbale_2x_print"/>
                    <div invisible="not nf_enbale_2x_print">
                        <label for="nf_copy_count" class="col-lg-3 o_light_label"/>
                        <field name="nf_copy_count"></field>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>