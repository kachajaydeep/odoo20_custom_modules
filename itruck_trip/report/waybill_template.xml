    <template id="report_waybill_template">
        <t t-call="itruck_trip.external_layout_waybill" style="padding-bottom: 25px;">
            <div class="page">

                <div class="text-center" style="color: white;background-color: #404040;">
                    <h5 style="padding-top:7px;padding-bottom:7px;">
                        <strong>Waybill</strong>       بوليصة الشحن<br/>
                        <span t-field="o.name"/>
                    </h5>
                </div>
                <br/>
                <div class="container" style="padding-bottom: 14px; padding-top: 10px;">
                    <table width="100%" class="table-bordered">
                        <body>
                            <tr>
                                <td width="15%">
                                    <strong>Trip Date</strong><br/>تاريخ الرحلة
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.date" t-options='{"widget": "date","format": "dd/MM/yyyy"}'/>
                                </td>
                                <td width="15%">
                                    <strong>Loading Point</strong><br/>نقطة التحميل
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.loading_point"/>
                                </td>
                                <td width="15%">
                                    <strong>Unloading Point</strong><br/>نقطة التنزيل
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.unloading_point"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="15%">
                                    <strong>Arrival Date</strong><br/>تاريخ الوصول
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.arrival_date" t-options='{"widget": "date","format": "dd/MM/yyyy"}'/>
                                </td>
                                <td width="15%">
                                    <strong>Commodity</strong><br/>الحمولة
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.product_type_id"/>
                                </td>
                                <td width="15%">
                                    <strong>Weight</strong><br/>الوزن
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.weight"/>
                                </td>
                            </tr>
                        </body>
                    </table>
                </div>

                <br/>
                <div class="text-center" style="color: white;background-color: #404040;">
                    <h5 style="padding-top:7px;padding-bottom:7px;">
                        <strong>Shipper</strong>       الشاحن
                    </h5>
                </div>
                <br/>
                <div class="container" style="padding-bottom: 10px;">
                    <table width="100%" class="table-bordered">
                        <body>
                            <tr>
                                <td width="15%">
                                    <strong>Shipper</strong><br/>الشاحن
                                </td>
                                <td>
                                    <span t-field="o.partner_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="15%">
                                    <strong>Consignee</strong><br/>المستلم
                                </td>
                                <td>
                                    <span t-if="o.consignee_id" t-esc="o.consignee_id.name"/>
                                </td>
                            </tr>
