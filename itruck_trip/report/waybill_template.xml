<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_waybill" model="report.paperformat">
        <field name="name">Waybill: A4</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">52</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True" />
    </record>

    <record id="report_itruck_waybill" model="ir.actions.report">
        <field name="name">Waybill</field>
        <field name="model">itruck.trip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">itruck_trip.report_waybill</field>
        <field name="report_file">itruck_trip.report_waybill</field>
        <field name="print_report_name">'%s - %s' % (object.partner_id.name, object.fleet_id.display_name if object.fleet_id else 'No Plate')</field>
        <field name="binding_model_id" ref="model_itruck_trip"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_waybill"/>
    </record>

