                        </body>
                    </table>
                </div>

                <br/>
                <div class="text-center" style="color: white;background-color: #404040;">
                    <h5 style="padding-top:7px;padding-bottom:7px;">
                        <strong>Carrier</strong>       الناقل
                    </h5>
                </div>
                <br/>
                <div class="container" style="padding-bottom: 10px;">
                    <table width="100%" class="table-bordered">
                        <body>
                            <tr>
                                <td width="15%">
                                    <strong>Truck Type</strong><br/>نوع الشاحنة
                                </td>
                                <td width="33.40%">
                                    <span t-field="o.fleet_type"/>
                                </td>
                                <td width="15%">
                                    <strong>Plate No</strong><br/>رقم اللوحة
                                </td>
                                <td width="36.60%">
                                    <span t-field="o.license_plate"/>
                                </td>
                            </tr>
                            <tr>
                                <td width="15%">
                                    <strong>Owner</strong><br/>مالك
                                </td>
                                <td width="33.40%">
                                    <span t-field="o.owner_id"/>
                                </td>
                                <td width="15%">
                                    <strong>Owner ID</strong><br/>معرف المالك
                                </td>
                                <td width="36.60%">
                                    <span t-field="o.owner_lic_id"/>
                                </td>
                            </tr>
                        </body>
                    </table>
                    <table width="100%" class="table-bordered">
                        <body>
                            <tr>
                                <td width="15%">
                                    <strong>Driver</strong><br/>السائق
                                </td>
                                <td width="18.33%">
                                    <t t-if="o.driver_id">
                                        <span t-field="o.driver_id.name"/>
                                    </t>
                                </td>
                                <td width="15%">
                                    <strong>Driver ID</strong><br/>معرف السائق
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.driver_lic_id"/>
                                </td>
                                <td width="15%">
                                    <strong>Driver Phone</strong><br/>سائق الهاتف
                                </td>
                                <td width="18.33%">
                                    <span t-field="o.driver_phone"/>
                                </td>
                            </tr>
                        </body>
                    </table>
                    <br/>
                    <div class="container" style="border: 1px solid black;">
                        <div dir="rtl">
                            نتعهد نحن "<strong><span t-field="o.vendor_id"/></strong>" بتوصيل بضائعكم سليمة إلى الوجهة المحددة اعلاه ونحن ملتزمون بسداد التعويض الجزئي أو الكلي الناتج عن أي ضرر يلحق بالبضائع على سبيل المثال ليس الحصر، سواء كان ذلك بسبب نقص أو تلف أو سرقة أو حريق وتسديده على الفور لشركة الناقل التقني للخدمات اللوجستية.
                        </div>
                    </div>
                    <br/>
                    <div class="container" style="border: 1px solid black;">
<!--                        <t t-if="o.note">-->
                            <div class="row">
                                <div class="col-2">
                                    <strong>Notes</strong>
                                </div>
                                <div class="col-10">
                                    <span t-field="o.note"/>
                                    <br/>
                                    <div style="text-align: right !important;">
                                        <img src="/itruck_trip/static/src/img/itruck-stamp.png" style="max-height: 130px;" alt="Stamp"/>
                                    </div>
                                </div>
                            </div>
<!--                        </t>-->
<!--                        <t t-else="">-->
<!--                            <div style="height: 100px;">-->
<!--                                <strong>Notes</strong>-->
<!--                            </div>-->
<!--                        </t>-->
                    </div>

                </div>
            </div>
        </t>
    </template>

    <template id="report_waybill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="itruck_trip.report_waybill_template" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
