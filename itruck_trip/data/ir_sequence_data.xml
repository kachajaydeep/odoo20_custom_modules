<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequences for itruck.trip -->
        <record id="seq_itruck_trip" model="ir.sequence">
            <field name="name">Itruck Trip</field>
            <field name="code">itruck.trip</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range" eval="True"/>
        </record>

        <record id="seq_res_partner_carrier" model="ir.sequence">
            <field name="name">Carrier</field>
            <field name="code">res.partner.carrier</field>
            <field name="prefix">CR-</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_res_partner_shipper" model="ir.sequence">
            <field name="name">Shipper</field>
            <field name="code">res.partner.shipper</field>
            <field name="prefix">SP-</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_trip_city" model="ir.sequence">
            <field name="name">Trip City</field>
            <field name="code">trip.city</field>
            <field name="padding">3</field>
        </record>

    </data>
</odoo>
