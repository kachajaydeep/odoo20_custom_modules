        <record id="model_iturck_trip_action_duplicate" model="ir.actions.server">
            <field name="name">Duplicate Trip</field>
            <field name="model_id" ref="itruck_trip.model_itruck_trip"/>
            <field name="binding_model_id" ref="itruck_trip.model_itruck_trip"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">action = records.action_duplicate_trips()</field>
        </record>

        <record id="model_iturck_trip_action_create_invoice" model="ir.actions.server">
            <field name="name">Create Invoice</field>
            <field name="model_id" ref="itruck_trip.model_itruck_trip"/>
            <field name="binding_model_id" ref="itruck_trip.model_itruck_trip"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.with_context(move_type='out_invoice').action_trip_account_move()
            </field>
        </record>

        <record id="model_iturck_trip_action_cancel_trip" model="ir.actions.server">
            <field name="name">Cancel Trips</field>
            <field name="model_id" ref="itruck_trip.model_itruck_trip"/>
            <field name="binding_model_id" ref="itruck_trip.model_itruck_trip"/>
            <field name="binding_view_types">list</field>
            <field name="groups_id"  eval="[(4, ref('itruck_trip.group_can_cancel_trip'))]"/>
            <field name="state">code</field>
            <field name="code">
                action = records.action_cancel()
            </field>
        </record>

        <record id="res_partner_view_search" model="ir.ui.view">
            <field name="name">res.partner.search.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='inactive']" position="before">
                   <filter string="Fulfilment" name="carrier_user_type" domain="[('user_type','=', 'carrier')]"/>
                   <separator/>
                </xpath>
            </field>
        </record>
        <record id="action_carrier_contacts" model="ir.actions.act_window">
            <field name="name">Carriers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form,activity</field>
            <field name="search_view_id" ref="base.view_res_partner_filter"/>
            <field name="context">{'search_default_carrier_user_type': 1, 'default_user_type': 'carrier',
                'default_is_company': True}</field>
            <field name="domain">['|', ('category_id.name','=','Carrier'), ('user_type','=','carrier')]</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a Carrier in your address book
              </p><p>
                Odoo helps you track all activities related to your contacts.
              </p>
            </field>
        </record>

        <menuitem id="menu_trip_management_root" name="Trip Management" sequence="10"/>

