<?xml version="1.0"?>
<odoo>

    <record id="trip_tag_view_form" model="ir.ui.view">
        <field name="name">trip.tag.view.form</field>
        <field name="model">trip.tag</field>
        <field name="arch" type="xml">
            <form string="Tags">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Services"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" required="True" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="trip_tag_view_list" model="ir.ui.view">
        <field name="name">sales.team.trip.tag.view.list</field>
        <field name="model">trip.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom" sample="1">
                <field name="name"/>
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <!-- Tags Configuration -->
    <record id="action_trip_tags" model="ir.actions.act_window">
        <field name="name">Trip Tags</field>
        <field name="res_model">trip.tag</field>
        <field name="view_id" ref="trip_tag_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create Trip Tags
            </p>
        </field>
    </record>

    <menuitem id="menu_trip_tags" name="Trip Tags"
              action="action_trip_tags"
              parent="menu_trip_management_configuration" sequence="7"/>
</odoo>
