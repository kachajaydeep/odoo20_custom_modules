<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="trip_city_list_view" model="ir.ui.view">
            <field name="name">trip.city.list</field>
            <field name="model">trip.city</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="trip_city_from_view" model="ir.ui.view">
            <field name="name">trip.city.form</field>
            <field name="model">trip.city</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="City Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_trip_city" model="ir.actions.act_window">
            <field name="name">Trip City</field>
            <field name="res_model">trip.city</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="menu_trip_city" name="City"
                  action="itruck_trip.action_trip_city"
                  parent="itruck_trip.menu_trip_management_configuration" sequence="20"/>

    </data>
</odoo>
