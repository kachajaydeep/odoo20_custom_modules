        <record id="trip_personal_trips_rule" model="ir.rule">
            <field name="name">Personal Trips</field>
            <field ref="model_itruck_trip" name="model_id"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('itruck_trip.group_personal_trips'))]"/>
        </record>

        <record id="trip_all_team_trips_rule" model="ir.rule">
            <field name="name">All Team Trips</field>
            <field ref="model_itruck_trip" name="model_id"/>
            <field name="domain_force">[('team_id', 'in', user.sale_team_leader_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('itruck_trip.group_all_team_trips'))]"/>
        </record>

        <record id="trip_rule_all_trips" model="ir.rule">
            <field name="name">All Trips</field>
            <field ref="model_itruck_trip" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('itruck_trip.group_trip_manager'))]"/>
        </record>

    </data>

