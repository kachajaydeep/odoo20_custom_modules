    <record id="itruck_trip.module_category_trips" model="ir.module.category">
        <field name="name">Trips</field>
        <field name="description">Helps you handle your Trips.</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_personal_trips" model="res.groups">
        <field name="name">User: Own Trips Only</field>
        <field name="category_id" ref="itruck_trip.module_category_trips"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">the user will have access to his own trips data in the Trip application.</field>
    </record>

    <record id="group_all_team_trips" model="res.groups">
        <field name="name">User: All Team Trips</field>
        <field name="category_id" ref="itruck_trip.module_category_trips"/>
        <field name="implied_ids" eval="[(4, ref('group_personal_trips'))]"/>
        <field name="comment">the user will have access to all Team Trips of every members in the Trip application.</field>
    </record>

    <record id="group_trip_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">the user will have access to Trips.</field>
        <field name="category_id" ref="itruck_trip.module_category_trips"/>
        <field name="implied_ids" eval="[(4, ref('group_all_team_trips'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

