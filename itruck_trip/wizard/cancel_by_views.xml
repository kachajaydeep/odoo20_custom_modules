<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="trip_cancel_by_from_view" model="ir.ui.view">
            <field name="name">trip.cancel.by.form</field>
            <field name="model">trip.cancel.by</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="trip_ids" widget="many2many_tags" invisible="1"/>
                                <field name="canceled_by" widget="radio"/>
                            </group>
                        </group>
                        <footer>
                            <button string="Cancel Trip" name="action_cancel_trip" type="object" class="oe_highlight"/>
                            <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
