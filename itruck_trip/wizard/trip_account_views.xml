<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="itruck_trip_account_move_from_view" model="ir.ui.view">
            <field name="name">itruck.trip.account.move.form</field>
            <field name="model">trip.account.move</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <label for="trip_ids"/>
                        <field name="trip_ids" widget="many2many_tags" readonly="1"/>
                        <group>
                            <group>
                                <field name="partner_id" invisible="1"/>
                                <field name="move_type" invisible="1"/>
                                <field name="need_to_create_separate_move"/>
                                <field name="move_id" options="{'no_create': True}"
                                       domain="[('partner_id', '=', partner_id), ('state', '=', 'draft')]"
                                       invisible="need_to_create_separate_move"/>
                            </group>
                        </group>
                        <footer>
                            <button string="Create Invoice" name="action_create_invoice" type="object"
                                    class="oe_highlight" invisible="move_type != 'out_invoice'"/>
                            <button string="Create Bill" name="action_create_bill" type="object"
                                    class="oe_highlight" invisible="move_type != 'in_invoice'"/>
                            <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
