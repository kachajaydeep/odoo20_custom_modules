<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherited" model="ir.ui.view">
        <field name="name">res.config.view.inherit.item.counter</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <setting id="pos-line-count" help="Enable to Display Total Prduct Lines Count for Order in Pos Order Screen and Receipt.">
                    <field name="nf_enable_line_count" />
                </setting>
                <setting id="pos-product-count" help="Enable to Display Total Product Quantity Count for Order in Pos Order Screen and Receipt.">
                    <field name="nf_enable_product_count" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
