<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="nf_tailor_management.TailorDashboard">
        <div class="nf-main-content container-fluid pt-5">
            <div class="page-content">
                <div class="container-fluid">
                    <div class="row ">
                        <div class="col-lg-8 col-12 ">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body d-flex flex-column row-gap-4">
                                        <div class="d-flex column-gap-3 align-items-center">
                                            <div class="avatar avatar-lg">
                                                <img class="rounded-circle o_user_avatar" style="width: 50px; height: 50px" t-att-src="this.state.user_img" alt="User" />
                                            </div>
                                            <h4 class="card-title m-0 p-0 user fs-4">
                                                <t t-out="this.greeting"></t>,
                                                <t t-out='this.user.display_name'/>
                                                <span>!</span>
                                            </h4>
                                        </div>
                                        <p class="card-text fs-5">
                                    Here's What's happening with your store today.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-12">
                            <div class="card">
                                <div class="card-content">
                                    <div class="card-body">
                                        <fieldset>
                                            <div class="input-group p-2">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">Start Date</span>
                                                </div>
                                                <input type="date" aria-label="Start Date" t-model.proxy="this.state.start_date" class="form-control" t-on-change="() => this.onchangeStartDate()" placeholder="Start Date" />
                                            </div>

                                            <div class="input-group p-2">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">End Date</span>
                                                </div>
                                                <input type="date" t-model.proxy="this.state.end_date" t-on-change="() => this.onchangeStartDate()" aria-label="End Date" class="form-control" placeholder="End Date" />
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <section>
                        <div class="row">
                            <div class="col-12 col-lg-3 col-md-6 col-sm-12">
                                <div class="card">
                                    <div class="card-body ">
                                        <div class="row">
                                            <div class="col-3">
                                                <div class="stats-icon purple">
                                                      <svg xmlns="http://www.w3.org/2000/svg"
