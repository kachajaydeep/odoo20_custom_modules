                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="col-9">
                                                <a class="text-white " href="/odoo/action-nf_tailor_management.action_nf_tailor_order/">
                                                    <h6 class="text-muted font-semibold text-formated nf-desktop-mini-header-font text-wrap">
                                                        <strong>
                                                            <span> Total Order</span>
                                                        </strong>
                                                    </h6>
                                                    <h6 class="font-extrabold mb-0  nf-desktop-mini-header-font">
                                                        <t t-out="this.state.total_order_count" />
                                                    </h6>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-3 col-md-6 col-sm-12">
                                <div class="card">
                                    <div class="card-body ">
                                        <div class="row">
                                            <div class="col-3">
                                                <div class="stats-icon green ">
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 0 320 512"
                                                        width="30"
                                                        height="30"
                                                        fill="#ffffff"
                                                    >
                                                        <path d="M48 64C21.5 64 0 85.5 0 112V400C0 426.5 21.5 448 48 448H80C106.5 448 128 426.5 128 400V112C128 85.5 106.5 64 80 64H48zM240 64C213.5 64 192 85.5 192 112V400C192 426.5 213.5 448 240 448H272C298.5 448 320 426.5 320 400V112C320 85.5 298.5 64 272 64H240z"/>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="col-9">
                                                <a class="text-white " href="/odoo/action-nf_tailor_management.action_nf_tailor_order_pending_orders/">
                                                    <h6 class="text-muted font-semibold text-formated nf-desktop-mini-header-font text-wrap">
                                                        <strong>
                                                            <span>Total Pending Order</span>
                                                        </strong>
                                                    </h6>
                                                    <h6 class="font-extrabold  nf-desktop-mini-header-font">
                                                        <t t-out='this.state.inprogres_orders_count' />
                                                    </h6>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-3 col-md-6 col-sm-12">
                                <div class="card">
                                    <div class="card-body ">
                                        <div class="row">
                                            <div class="col-3">
                                                <div class="stats-icon blue mb-2">
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 0 512 512"
                                                        width="30"
                                                        height="30"
                                                        fill="#ffffff"
                                                    >
