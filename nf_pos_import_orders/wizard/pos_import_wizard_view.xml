<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_import_wizard_form" model="ir.ui.view">
        <field name="name">pos.import.wizard.form</field>
        <field name="model">nf.pos.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import POS Orders">
                <group invisible="state != 'draft'">
                    <field name="session_id" options="{'no_create': True}" />
                    <field name="payment_method_id" options="{'no_create': True}" />
                    <field name="file" filename="filename" widget="binary" options="{'accepted_file_extensions': '.xlsx'}" />
                    <field name="filename" invisible="1"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="import_result" widget="text" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_import_wizard" model="ir.actions.act_window">
        <field name="name">Import POS Orders</field>
        <field name="res_model">nf.pos.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>