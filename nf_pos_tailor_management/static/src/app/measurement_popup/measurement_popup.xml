<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="nf_pos_tailor_management.Measurement">
        <Dialog>
            <div>
                <t t-set-slot="header">
                    <h2>Select Mesurement</h2>
                    <button type="button" class="btn-close" t-on-click="() => this.closePopup()" aria-label="Close"></button>
                </t>
                <t t-if="this.state.measurement">
                    <t t-foreach="this.state.measurement" t-as="measurement"
                        t-key="measurement.id">
                        <div  t-on-click="() => this.getCutomerMeasurement(measurement)">
                            <div class="d-flex justify-content-between align-items-center border p-3 mt-2 cursor-pointer">
                                <div>
                                    <span t-out="measurement.name" class="h3"></span>
                                </div>
                                
                                <div><i class="fa fa-angle-right fs-2"></i></div>
                            </div>
                        </div>
                    </t>
                </t>

                <t t-set-slot="footer">
                    <button class="btn btn-primary"
                        t-on-click="() => this.createMeasurement()">
                        Create
                    </button>

                    <t t-set-slot="footer">
                        <button class="btn btn-secondary border-1"
                            t-on-click="() => this.closePopup()">
                            Cancel
                        </button>
                    </t>
                </t>
            </div>
        </Dialog>
    </t>
</templates>