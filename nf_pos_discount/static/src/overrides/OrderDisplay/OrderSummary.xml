<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="nf_pos_discount.OrderDisplay"
       t-inherit="point_of_sale.OrderDisplay"
       t-inherit-mode="extension">
        <xpath expr="//div[@id='order-widget-taxes']/.." position="after">
            <div class="d-flex justify-content-between w-100 text-muted" t-if="this.nfTotalDiscount">
                <span>Discount</span>
                <span t-out="this.pos.formatCurrency(this.nfTotalDiscount)" class="total"/>
            </div>
        </xpath>
    </t>
</templates>