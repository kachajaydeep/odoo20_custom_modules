<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='nf_pos_check_availibility' model='ir.ui.view'>
        <field name='name'>nf.pos.stock.availibility.settings.form</field>
        <field name='model'>res.config.settings</field>
        <field name='inherit_id' ref="point_of_sale.res_config_settings_view_form" />
        <field name='arch' type='xml'>
            <block id="pos_interface_section" position="inside" >
                <xpath expr="//block[@id='pos_interface_section']" position="inside">
                    <setting id="nf_check_stock_setting" string="Check Stock Availability" help="Restrict POS sales based on product stock availability." >
                        <field name="nf_check_stock"/>
                        <div class="content-group mt16" invisible="not nf_check_stock">
                            <div>
                                <field name="nf_allow_to_sale"/>
                                <label for="nf_allow_to_sale" string="Allow To Sale" class="fw-normal me-1"/>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </block>
        </field>
    </record>
</odoo>