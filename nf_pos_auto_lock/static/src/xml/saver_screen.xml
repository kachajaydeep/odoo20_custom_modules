<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="nf_pos_auto_lock.SaverScreen" t-inherit="point_of_sale.SaverScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('flex-grow-1')]" position="replace">
            <div t-if="this.env.services.pos.config.nf_enable_auto_lock" class="flex-grow-1 d-flex h-100 w-100 justify-content-center align-items-center">
                <img t-att-height="this.uiService.isSmall ? 40 : 182" t-att-src="'/web/image?model=res.company&amp;id=' + this.env.services.pos.company.id + '&amp;field=logo'" alt="Logo"/>
            </div>
            <div t-else="" class="flex-grow-1 d-flex h-100 w-100 justify-content-center align-items-center">
                <div class="pos-logo w-100 h-25"/>
            </div>
        </xpath>
    </t>
</templates>
