<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherited" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherited</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Secondary UOM" help="Allow to Add and Select Secondary UOM for Products in POS.">
                    <field name="allow_secondary_uom" readonly="has_active_session" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
