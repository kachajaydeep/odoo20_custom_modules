<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_form_inherited" model="ir.ui.view">
        <field name="name">product.view.form.inherited</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='to_weight']" position="before">
                <field name="is_default_uom" />
                <field name="default_uom_id" 
                    required="is_default_uom" 
                    invisible="not is_default_uom" 
                    options="{'no_quick_create': True, 'edit_tags': True}" 
                    context="{'product_id': id}" 
                />
                <field name="uom_ids" 
                    widget="many2many_uom_tags"  
                    options="{'no_quick_create': True, 'edit_tags': True}" 
                    context="{'product_id': id}"
                />
            </xpath>
        </field>
    </record>
</odoo>
