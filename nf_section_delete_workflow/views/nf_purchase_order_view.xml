<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_purchase_order_form_view_inherit" model="ir.ui.view">
        <field name="name">nf.purchase.order.form.view.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']"
                position="after">

                <field name="nf_section_name" readonly="1" column_invisible="1" />

            </xpath>
        </field>
    </record>
</odoo>