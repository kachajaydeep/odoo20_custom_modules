<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_sale_order_form_inherit_section_name" model="ir.ui.view">
        <field name="name">sale.order.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='name']"
                position="after">

                <field name="nf_section_name" readonly="1" column_invisible="1" />

            </xpath>

        </field>
    </record>
</odoo>