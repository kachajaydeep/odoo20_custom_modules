<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_account_move_form_view_inherit" model="ir.ui.view">
        <field name="name">nf.account.move.form.view.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                position="after">

                <field name="nf_section_name" readonly="1"  column_invisible="1" />

            </xpath>
        </field>
    </record>
</odoo>