<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nf_pos_order_list.nfPosOrderLinesPopup">
        <Dialog title="this.props.title" >
            <main class="body modal-body overflow-auto">
                <table class="table table-striped w-100">
                    <thead>
                        <th class="p-2 nf-product-name-header">Full Product Name</th>
                        <th class="p-2">Quantity</th>
                        <th class="p-2">Unit Price</th>
                        <th class="p-2">Disc.(%)</th>
                        <th class="p-2">Taxes</th>
                        <th class="p-2">Subtotal w/o Tax </th>
                        <th class="p-2">Subtotal</th>
                    </thead>
                    <tbody>
                        <t t-foreach="this.props.lines" t-as="line" t-key="line.id">
                            <tr>
                                <td class="nf-product-name">
                                    <t t-out="line.product_id.display_name" ></t>
                                </td>
                                <td>
                                    <t t-out="line.qty" ></t>
                                </td>
                                <td>
                                    <t t-if="line.price_unit" >
                                        <t t-out="this.env.utils.formatCurrency(line.price_unit)" ></t>
                                    </t>
                                    <t t-else="" >
                                        0.00
                                    </t>
                                </td>
                                <td>
                                    <t t-out="line.discount" ></t>
                                </td>
                                <td>
                                    <t t-foreach="line.tax_ids" t-as="tax_id" t-key="tax_id.id" >
                                        <t t-out="tax_id.name " ></t>,
                                    </t>
                                </td>
                                <td  >
                                    <t t-if="line.price_subtotal" >
                                        <t t-out="this.env.utils.formatCurrency(line.price_subtotal)" ></t>
                                    </t>
                                    <t t-else="" >
                                        0.00
                                    </t>
                                </td>
                                <td>
                                    <t  t-if="line.price_subtotal_incl"  >
                                        <t t-out="this.env.utils.formatCurrency(line.price_subtotal_incl)" ></t>
                                    </t>
                                    <t t-else="">
                                        0.00
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td style="text-align: right !important;" colspan="6" >
                                <b>
                                    Taxes :
                                </b> 
                            </td>
                            <td >
                                <t t-if="this.props.total_tax" >
                                    <t t-out="this.env.utils.formatCurrency(this.props.total_tax)" ></t>
                                </t>
                                <t t-else="" > 
                                    0.00
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right !important;" colspan="6" >
                                <b>
                                    Total :
                                </b> 
                            </td>
                            <td >
                                <t t-if="this.props.order_total" >
                                    <t t-out="this.env.utils.formatCurrency(this.props.order_total)" ></t>
                                </t>
                                <t t-else="" >
                                    0.00
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right !important;" colspan="6" >
                                <b>
                                    Total Paid : 
                                </b> 
                            </td>
                            <td >
                                <t t-out="this.env.utils.formatCurrency(this.props.total_paid)" ></t>
                            </td>
                        </tr>
                    </tbody> 
                </table>
            </main>
        </Dialog>
    </t>

</templates>
