<?xml version="1.0" encoding="UTF-8"?>
<templates id='template' xml:space='preserve'>
    <t t-name="Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension" >
        <xpath expr="//div[hasclass('product-price')]" position="after">
            <t t-if="this.nf_is_gretore and ((!this.line.order_id.finalized and this.line.config.nf_pos_enable_dicsounted_price_on_cart) or (this.line.order_id.finalized and this.line.config.nf_pos_enable_discounted_price_in_receipt))">
                <div class="price text-muted ms-2">
                    <div class="nf_price" style="text-decoration: line-through; font-size: 13px;">
                        <t t-out="this.env.utils.formatCurrency(this.nf_product_price * this.line.qty)" />
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>