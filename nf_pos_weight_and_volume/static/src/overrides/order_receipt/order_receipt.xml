<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="nf_pos_weight_and_volume.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="after">
            <t t-if="this.pos.config.nf_display_weight_in_Receipt">
                <div class="d-flex justify-content-between pt-2 text-muted small">
                      <b>Total Weight:</b>
                      <span>
                          <t t-out="totalWeight"/>
                      </span>
                </div>
            </t>
            <t t-if="this.pos.config.nf_pos_display_volume_in_receipt">
                <div class="d-flex justify-content-between pt-2 text-muted small">
                    <b>Total Volume:</b>
                    <span>
                        <t t-out="totalVolume"/>
                    </span>
                </div>
            </t>
        </xpath>
    </t>
</templates>