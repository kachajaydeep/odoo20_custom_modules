<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nf_price_checker_kiosk.NfPriceCheckerKiosk">
        <div class="nf-price-checker-container">

            <!-- HEADER -->
            <header class="nf-header">
                <div class="d-flex flex-column">
                    <div class="nf-company-logo">
                        <img t-if="this.state.settings.company_config_logo" t-att-src="this.state.settings.logo" alt="Company Logo"/>
                    </div>
                    <div t-if="this.state.settings.company_config_name" class="nf-title">
                        <t t-out="this.state.settings.company_name"/>
                    </div>
                </div>
                <div class="nf-header-right">
                    <button class="nf-theme-toggle" t-on-click="this.toggleTheme" t-att-title="this.state.theme === 'dark' ? 'Switch to Light Mode' : 'Switch to Dark Mode'">
                        <!-- <i t-attf-class="fa #{this.state.theme === 'dark' ? 'fa-sun-o' : 'fa-moon-o'}"/> -->
                        <t t-if="this.state.theme === 'dark'">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="4"/>
                                <path d="M12 2v2"/>
                                <path d="M12 20v2"/>
                                <path d="m4.93 4.93 1.41 1.41"/>
                                <path d="m17.66 17.66 1.41 1.41"/>
                                <path d="M2 12h2"/>
                                <path d="M20 12h2"/>
                                <path d="m6.34 17.66-1.41 1.41"/>
                                <path d="m19.07 4.93-1.41 1.41"/>
                            </svg>
                        </t>
                        <t t-else="">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                            </svg>
                        </t>

                    </button>
                </div>
            </header>

            <!-- MAIN CONTENT -->
            <div class="nf-main-content">

                <!-- LEFT PANEL (PRODUCT) -->
                <t t-if="this.state.settings.show_name ||
                    this.state.settings.show_image ||
                    this.state.settings.show_price ||
                    this.state.settings.show_code ||
                    this.state.settings.show_barcode ||
                    this.state.settings.show_stock ||
                    this.state.settings.show_specification ||
                    this.state.settings.show_category ||
                    this.state.settings.show_product_weight ||
                    this.state.settings.show_product_sales_description ||
                    this.state.settings.show_product_tax ||
                    this.state.settings.show_pricelist"
                    >
                    <div class="nf-left-panel">
                        <div t-if="this.state.product" class="nf-product-details">
                            <div t-if="this.state.settings.show_image" class="nf-product-image">
                                <img t-att-src="this.state.product.image_url" alt="Product Image"/>
                            </div>
    
                            <div class="nf-product-info">
                                <div t-if="this.state.settings.show_name" class="nf-product-name">
                                    <t t-out="this.state.product.name"/>
                                </div>
    
                                <div t-if="this.state.settings.show_price" class="nf-product-price">
                                    <div class="nf-label">Sale Price</div>
                                    <t t-out="this.state.product.lst_price"/>
                                </div>
    
                                <div class="nf-info-grid">
                                    <div t-if="this.state.settings.show_code" class="nf-info-item">
                                        <div class="nf-label">Product Code</div>
                                        <t t-if="this.state.product.default_code">
                                            <div class="nf-value"><t t-out="this.state.product.default_code"/></div>
                                        </t>
                                        <t t-else="">
                                            <div style="color:yellow">
                                                The product does not have a default code
                                            </div>
                                        </t>
                                    </div>
    
                                    <div t-if="this.state.settings.show_barcode" class="nf-info-item">
                                        <div class="nf-label">Barcode</div>
                                        <t t-if="this.state.product.barcode">
                                            <div class="nf-value"><t t-out="this.state.product.barcode"/></div>
                                        </t>
                                        <t t-else="">
                                            <div style="color:yellow">
                                                The product does not have a Barcode.
                                            </div>
                                        </t>
                                    </div>
    
                                    <div t-if="this.state.settings.show_category" class="nf-info-item">
                                        <div class="nf-label">Category</div>
                                        <div class="nf-value"><t t-out="this.state.product.category"/></div>
                                    </div>
                                    <div t-if="this.state.settings.show_product_weight" class="nf-info-item">
                                        <div class="nf-label">product weight</div>
                                        <t t-if="this.state.product.weight">
                                            <div class="nf-value"><t t-out="this.state.product.weight"/></div>
                                        </t>
                                        <t t-else="">
                                            <div style="color:yellow">
                                                The product does not have any Weight.
                                            </div>
                                        </t>
                                    </div>
    
                                    <div t-if="this.state.settings.show_product_tax" class="nf-info-item">
                                        <div class="nf-label">Product Taxes</div>
                                        <t t-if="this.state.product.taxes.length">
                                            <div class="d-flex gap-3 flex-wrap">
                                                <t t-foreach="this.state.product.taxes" t-as="tax" t-key="tax.id">
                                                    <span class="badge text-bg-success">
                                                        <t t-out="tax"/>
                                                    </span>
                                                </t>
                                            </div>
                                        </t> 
                                        <t t-else="">
                                            <div style="color:yellow">
                                                The product does not have any tax.
                                            </div>
                                        </t>
                                    </div>
    
                                    <div t-if="this.state.settings.show_stock" class="nf-info-item">
                                        <div class="nf-label">Stock Available</div>
                                        <t t-if="this.state.product.qty_available">
                                            <div class="nf-stock-badge">
                                                <t t-out="this.state.product.qty_available"/> Units
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div style="color:yellow;">
                                                The product does not have any stock.
                                            </div>
                                        </t>
                                    </div>
                                </div>

                                <div t-if="this.state.settings.show_pricelist and this.state.product.pricelist_prices.length" class="nf-pricelist-section">
                                    <span class="nf_pricelist_text">Offer</span>
                                </div>
    
                                <div class="d-flex justify-content-between">
                                    <t t-foreach="this.state.product.pricelist_prices" t-as="pl" t-key="pl.name">
                                        <div t-if="this.state.settings.show_pricelist and this.state.product.pricelist_prices.length" class="nf-info-item">
                                            <div t-if="pl.compute_price === 'fixed'" class="nf-product-price pricelist-price">
                                                <div class="nf-label"><t t-out="pl.name"/></div>
                                                <div class="nf-value" style="font-size:1rem;"><t t-out="pl.price"/></div>
                                            </div>
    
                                            <!-- PERCENTAGE or FORMULA — show discounted price + badge, hide lst_price -->
                                            <div t-else="" class="nf-product-price pricelist-price discounted">
                                                <div class="nf-label"><t t-out="pl.name"/></div>
                                                <div class="nf-value" style="font-size:1rem;">                                           
                                                    <t t-out="pl.discount_amount"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
            
    
                                <div t-if="this.state.settings.show_specification and this.state.product.description_sale" class="nf-info-item">
                                    <div class="nf-label">Description Sale</div>
                                    <div class="nf-value nf-small-text">
                                        <t t-out="this.state.product.description_sale"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
                <t t-else="">
                    <div class="nf-error-message nf-left-panel">
                        <span>Please configure the product details as required.</span>
                    </div>
                </t>

                <!-- RIGHT PANEL -->
                <div class="nf-right-panel">

                    <!-- SEARCH -->
                    <div class="nf-search-section">
                        <div class="nf-search-box">
                            <input type="text"
                                   t-ref="this.inputRef"
                                   placeholder="Scan Barcode or Enter Product Code..."
                                   t-model.proxy="this.state.barcode"
                                   t-on-keydown="this.onBarcodeEnter"
                                   autocomplete="off"/>
                            <button class="nf-search-btn d-flex align-items-center justify-content-center" t-on-click="this.onSearchClick">
                                <!-- <i class="fa fa-search"></i> -->
                                <svg class="svg-inline--fa fa-magnifying-glass" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="magnifying-glass" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="1em" height="1em">
                                    <path fill="currentColor" d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.1-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0s208 93.1 208 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"></path>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- ERROR -->
                    <div t-if="this.state.error" class="nf-error-message">
                        <t t-out="this.state.error"/>
                    </div>

                    <!-- IDLE -->
                    <div t-else="" class="nf-idle-message">
                        Ready to scan!
                    </div>

                    <!-- KEYBOARD -->
                    <div t-if="this.state.settings.show_keyboard" class="nf-keyboard-container">
                        <div class="nf-keyboard">
                            <t t-foreach="this.keys" t-as="key" t-key="key">
                                <div class="nf-key"
                                     t-att-class="{'nf-wide': key === 'ENTER' or key === 'BACK'}"
                                     t-on-click="() => this.onKeyClick(key)">
                                    <t t-out="key"/>
                                </div>
                            </t>
                            <div class="nf-key nf-wide" t-on-click="() => this.onKeyClick('CLEAR')">CLEAR</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </t>
</templates>